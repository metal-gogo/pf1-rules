{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "catalog_version": "0.1.0",
  "sources": [
    {
      "id": "aon",
      "name": "Archives of Nethys - Pathfinder RPG Database",
      "base_url": "https://www.aonprd.com/",
      "role": "primary_candidate",
      "expected_strengths": [
        "broad first-party coverage",
        "book and page provenance",
        "FAQ and errata integration",
        "Pathfinder Society metadata"
      ],
      "known_review_points": [
        "separate Open Game Content from Product Identity before any distribution",
        "detect FAQ and errata transformations",
        "preserve later-class spell-list additions as scope expansions"
      ],
      "third_party_default": "exclude"
    },
    {
      "id": "legacy_aon",
      "name": "Legacy Pathfinder Reference Document",
      "base_url": "https://legacy.aonprd.com/",
      "role": "stable_baseline",
      "expected_strengths": [
        "static book-oriented pages",
        "clean Open Game License baseline",
        "predictable HTML",
        "strong Core Rulebook intersection"
      ],
      "known_review_points": [
        "frozen coverage",
        "limited later-book integration",
        "may not reflect every later FAQ or correction"
      ],
      "third_party_default": "exclude"
    },
    {
      "id": "d20pfsrd",
      "name": "d20PFSRD",
      "base_url": "https://www.d20pfsrd.com/",
      "role": "secondary_comparison",
      "expected_strengths": [
        "broad coverage",
        "structured spell presentation",
        "independent comparison source"
      ],
      "known_review_points": [
        "explicit third-party sections",
        "book and page provenance may be absent",
        "remove advertisements and unrelated page content",
        "verify publisher identity before accepting a record"
      ],
      "third_party_default": "exclude"
    }
  ]
}
