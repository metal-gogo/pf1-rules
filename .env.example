# Local database development needs no environment variable; the project uses
# data/database/pf1_spells.db by default.

# Store retained raw source artifacts outside the repository.
# PF1_ARTIFACT_ROOT="/mnt/c/Users/Usuario/Documents/pf1-rules-artifacts"

# At the Neon transition, set the PostgreSQL connection URL after changing the
# Prisma datasource provider to `postgresql`.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
