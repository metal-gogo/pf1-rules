              ]
            },
            {
              "node_type": "text",
              "value": ": If you assume this form, you gain a +2 size bonus to your Dexterity and Constitution scores."
            }
          ]
        },
        {
          "node_type": "paragraph",
          "content": [
            {
              "node_type": "text",
              "value": "Medium Fey",
              "marks": [
                "bold"
              ]
            },
            {
              "node_type": "text",
              "value": ": If you assume this form, you gain a +2 size bonus to your Strength and Constitution scores."
            }
          ]
        }
      ]
    }
