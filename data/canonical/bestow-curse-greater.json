              "value": "wish",
              "marks": [
                "italic"
              ]
            },
            {
              "node_type": "text",
              "value": " spell. It cannot be removed with "
            },
            {
              "node_type": "text",
              "value": "remove curse",
              "marks": [
                "italic"
              ]
            },
            {
              "node_type": "text",
              "value": " or suppressed with "
            },
            {
