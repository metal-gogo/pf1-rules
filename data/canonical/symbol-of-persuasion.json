      "status": "accepted",
      "evidence": [
        {
          "observation_id": "aon:spell.symbol-of-persuasion:f74cb363ffe1836a",
          "source_field": "spell_raw.description_raw",
          "evidence_kind": "plain_text",
          "anchor_text_raw": "This spell functions like symbol of death, except that all creatures within the radius of a symbol of persuasion instead become charmed by the caster (as the charm monster spell) for 1 hour per caster level.\n\nUnlike symbol of death, symbol of persuasion has no hit point limit; once triggered, a symbol of persuasion simply remains active for 10 minutes per caster level.\n\nNote: Magic traps such as symbol of persuasion are hard to detect and disable. A rogue (only) can use the Perception skill to find a symbol of persuasion and Disable Device to thwart it. The DC in each case is 25 + spell level, or 31 for symbol of persuasion.",
          "source_href": null
        },
        {
          "observation_id": "legacy_aon:spell.symbol-of-persuasion:797cb5b09110f4cf",
