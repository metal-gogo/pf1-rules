    {
      "relationship_id": "spell.detect-anxieties:functions_like:spell.detect-thoughts",
      "type": "functions_like",
      "target": {
        "entity_type": "spell",
        "entity_id": "spell.detect-thoughts",
        "name": "Detect Thoughts"
      },
      "status": "accepted",
      "evidence": [
        {
          "observation_id": "aon:spell.detect-anxieties:fd9539528aa36d98",
          "source_field": "spell_raw.description_raw",
          "evidence_kind": "plain_text",
          "anchor_text_raw": "This spell functions as detect thoughts except that you sense significant anxieties of creatures with an Intelligence score of 1 or higher, regardless of whether they are conscious or not.\n\nInstead of Intelligence, the second round of concentration reveals each mind’s Wisdom score and current degree of fear (shaken, frightened, panicked, cowering, or paralyzed with fear). If the highest Wisdom score is 26 or higher (and at least 10 points higher than your own Wisdom score), you are stunned for 1 round and the spell ends.\n\nInstead of surface thoughts, the third round of concentration reveals the most pressing current anxiety of any mind in the area (Will negates).\n\nPresenting a creature with the threat of its anxiety grants you a +2 bonus (or higher, at the GM’s discretion) on checks to Intimidate that creature.",
          "source_href": null
        }
      ],
      "note": null
    },
