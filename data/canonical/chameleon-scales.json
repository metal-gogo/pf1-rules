              "node_type": "entity_link",
              "value": "Disguise",
              "relationship_id": "spell.chameleon-scales:uses_definition:skill.disguise"
            },
            {
              "node_type": "text",
              "value": " to appear as a member of a different race as long as that race has the same type and color of skin, hide, or scales as you."
            }
          ]
        }
      ]
    }
