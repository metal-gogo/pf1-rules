  "description": {
    "raw": "This spell functions like cure light wounds, except that it cures 2d8 points of damage + 1 point per caster level (maximum +10).",
    "search_text": "Cure Moderate Wounds functions like Cure Light Wounds. By touch, it cures a living creature for 2d8 plus 1 per caster level, maximum +10, but damages undead; an undead target can apply spell resistance and attempt a Will save for half damage.",
    "sections": [
      {
        "heading": "Description",
        "body": "This spell functions like cure light wounds, except that it cures 2d8 points of damage + 1 point per caster level (maximum +10)."
      }
