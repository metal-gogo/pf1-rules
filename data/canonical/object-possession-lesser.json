      "target": {
        "entity_type": "spell",
        "entity_id": "spell.possession",
        "name": "Possession"
      },
      "status": "accepted",
      "evidence": [
        {
          "observation_id": "aon:spell.object-possession-lesser:13276d0037774ffe",
          "source_field": "spell_raw.description_raw",
          "evidence_kind": "plain_text",
          "anchor_text_raw": "This spell functions as possession, except you possess an object instead of a creature.\n\nA possessed object becomes capable of animation, gaining the statistics of an animated object of its size (including 1 CP worth of abilities; Pathfinder RPG Bestiary 14). You can’t use any spells or other abilities while possessing an object.\n\nA spiritual tether connects your body to the possessed object, in a manner similar to a silver cord (see page 244). If the possessed object and your body are ever farther than close range (25 ft. + 5 ft./2 levels) from one another, this tether breaks, returning your consciousness to your body.",
          "source_href": null
        }
      ],
      "note": null
    },
