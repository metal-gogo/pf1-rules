    "delivery": {
      "resolution": "fixed",
      "entries": [
        {
          "label_raw": "Effect",
          "value_raw": "The weather in the cursed region changes drastically, even bringing snow to a blazing desert. The area is plagued by your choice of cold weather conditions (Core Rulebook 442), very hot conditions (Core Rulebook 444), or frequent powerful storms (Core Rulebook 438). The weather remains unpredictable, and can change over time (as determined by the GM), but the baseline weather is altered as long as the curse remains.",
          "kinds": [
            "effect"
          ]
        },
        {
          "label_raw": "Area",
          "value_raw": "2-mile radius emanating from the touched point",
