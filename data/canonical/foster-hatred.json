          "content": [
            {
              "node_type": "text",
              "value": "You build upon your targets’ innate prejudice, stoking it from a simmer to the full flame of hatred. Choose a creature type (if you choose "
            },
            {
              "node_type": "entity_link",
              "value": "humanoid",
              "relationship_id": "spell.foster-hatred:uses_definition:monster-type.humanoid"
            },
