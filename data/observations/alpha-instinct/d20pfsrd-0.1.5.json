    "casting_time_raw": "10 minutes",
    "components_raw": "V, S, M (a bit of musk from an alpha wolf or another socially dominant animal)",
    "range_raw": "personal",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "you",
