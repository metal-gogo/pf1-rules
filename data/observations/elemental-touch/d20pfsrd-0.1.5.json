    ],
    "levels_raw": "alchemist 2, bloodrager 2, magus 2, sorcerer/wizard 2",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a bit of the chosen element: earth, water, air, or fire)",
    "range_raw": "personal",
    "delivery_fields_raw": [
      {
        "label_raw": "Targets",
        "value_raw": "you",
