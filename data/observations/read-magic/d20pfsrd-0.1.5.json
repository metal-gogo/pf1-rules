    "name_raw": "Read Magic",
    "alternate_names_raw": [],
    "school_raw": "divination",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "antipaladin 1, bard 0, cleric/oracle 0, druid 0, inquisitor 0, magus 0, paladin 1, psychic 0, ranger 1, shaman 0, sorcerer/wizard 0, summoner/unchained summoner 0, witch 0",
