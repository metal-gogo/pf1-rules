  "spell_raw": {
    "name_raw": "Strangling Hair",
    "alternate_names_raw": [],
    "school_raw": "transmutation",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "psychic 3, sorcerer/wizard 3, witch 3",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one creature",
