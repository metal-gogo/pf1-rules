  "spell_raw": {
    "name_raw": "Build Trust",
    "alternate_names_raw": [],
    "school_raw": "divination",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "bard 2, cleric 2, inquisitor 2, mesmerist 2, paladin 1, psychic 2",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a gold piece)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one creature",
