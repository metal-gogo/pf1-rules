    "levels_raw": "alchemist 4, arcanist 4, bard 4, investigator 4, medium 4, mesmerist 4, occultist 4, psychic 4, shaman 4, skald 4, sorcerer 4, spiritualist 4, summoner 4, summoner (unchained) 4, witch 4, wizard 4",
    "domains_raw": null,
