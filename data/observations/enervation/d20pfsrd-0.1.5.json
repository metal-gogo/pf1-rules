  "spell_raw": {
    "name_raw": "Enervation",
    "alternate_names_raw": [],
    "school_raw": "necromancy",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "bloodrager 4, sorcerer/wizard 4, witch 4",
