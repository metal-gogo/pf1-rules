    "name_raw": "Unconscious Agenda",
    "alternate_names_raw": [],
    "school_raw": "enchantment (compulsion) [language-dependent, mind-affecting]",
    "subschool_raw": "compulsion",
    "descriptors_raw": [
      "language-dependent",
      "mind-affecting"
    ],
    "levels_raw": "bard 6, inquisitor 6, sorcerer/wizard 6, witch 6",
    "domains_raw": null,
    "casting_time_raw": "10 minutes",
    "components_raw": "V",
    "range_raw": "Close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
