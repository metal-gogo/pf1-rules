    ],
    "levels_raw": "bard 3, medium 3, mesmerist 3, psychic 4, sorcerer/wizard 4",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a pinch of black sand)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "up to one creature/level, no two of which can be more than 30 feet apart",
