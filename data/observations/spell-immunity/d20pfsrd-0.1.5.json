  "spell_raw": {
    "name_raw": "Spell Immunity",
    "alternate_names_raw": [],
    "school_raw": "abjuration",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "alchemist 4, cleric/oracle 4, inquisitor 4",
    "domains_raw": "protection 4, strength 4",
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, DF",
    "range_raw": "touch",
    "delivery_fields_raw": [
