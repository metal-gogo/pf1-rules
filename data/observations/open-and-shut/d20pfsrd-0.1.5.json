    "domains_raw": null,
    "casting_time_raw": "1 swift action",
    "components_raw": "V, S, F (a doornail, doorknob, or hinge)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one door, window, or similar portal no more than 10 feet by 10 feet in area",
        "kinds": [
          "target"
        ]
      }
    ],
    "duration_raw": "1 round/level (D)",
    "saving_throw_raw": "Will disbelief",
    "spell_resistance_raw": "no",
    "description_raw": "You alter the appearance of a door and disguise whether it is open or closed. You can cause the touched door to appear closed regardless of whether it is open or closed, to appear open regardless of whether it is open or closed, or to appear to open or close. After you cast the spell, you can change between these options as a move action. Creatures using a move action to open or shut the door can attempt a Will save to disbelieve the illusion.\n\nRegardless of how you alter the appearance of the door, creatures that believe the illusion take a –5 penalty on Perception checks regarding the door itself or creatures on the other side of the door.\n\nThis spell affects windows, gates, and similar openings in the same way it affects doors.",
