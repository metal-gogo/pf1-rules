  "spell_raw": {
    "name_raw": "Protection from Spores",
    "alternate_names_raw": [],
    "school_raw": "abjuration",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "alchemist 2, cleric/oracle 2, druid 2, hunter 1, investigator 2, ranger 1, shaman 2, warpriest 2, witch 2",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S",
    "range_raw": "touch",
    "delivery_fields_raw": [
