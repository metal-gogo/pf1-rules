  "spell_raw": {
    "name_raw": "Dimensional Lock",
    "alternate_names_raw": [],
    "school_raw": "abjuration",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "cleric/oracle 8, sorcerer/wizard 8, summoner 6, Bloodline accursed 8",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S",
    "range_raw": "medium (100 ft. + 10 ft./level)",
    "delivery_fields_raw": [
      {
        "label_raw": "Area",
        "value_raw": "20-ft.-radius emanation centered on a point in space",
