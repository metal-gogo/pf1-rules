    "levels_raw": "arcanist 4, bard 4, cleric 4, occultist 3, oracle 4, psychic 4, skald 4, sorcerer 4, summoner 3, unchained summoner 3, warpriest 4, wizard 4",
    "domains_raw": null,
    "casting_time_raw": "10 minutes",
    "components_raw": "V, S, F (a miniature ship; see text)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Effect",
        "value_raw": "One conjured ship",
