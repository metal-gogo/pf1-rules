    ],
    "levels_raw": "antipaladin 4, bard 6, mesmerist 6, psychic 8, sorcerer/wizard 8",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a black mask)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
