    "sections_raw": [
      {
        "heading_raw": "Prerequisites",
        "body_raw": "Favored terrain (desert) class feature."
      },
      {
        "heading_raw": "Benefit",
        "body_raw": "You treat hot environments (Core Rulebook 444) as though they were one step less severe; if you have a similar ability from another feat, such as Torrid Tolerance, the benefits stack and you treat hot conditions as if they were two steps less severe. You need to consume only half the normal amount of water for a creature of your size, and you gain a +4 bonus on Constitution checks to resist the effects of thirst. You also gain a +4 bonus on saving throws and checks to avoid becoming blinded or dazzled by glare or being deceived by a desert mirage."
      }
    ],
