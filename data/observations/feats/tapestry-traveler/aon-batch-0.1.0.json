  "entity_raw": {
    "name_raw": "Tapestry Traveler",
    "definition_type_raw": null,
    "source_book_raw": "Pathfinder Society Primer pg. 13",
    "definition_raw": "Source Pathfinder Society Primer pg. 13\nYour many visits to the Hao Jin Tapestry demiplane have made you an expert in long-distance travel.\n\nPrerequisites: Character level 5th.\n\nBenefit: You cast spells of the teleportation subschool as though your caster level were 2 higher, and you treat yourself as one step more familiar when teleporting to an established Pathfinder lodge with the teleport spell. If you can teleport as a supernatural ability, you treat your class level as if it were 2 higher when calculating the total distance that you can travel with this ability.",
    "links_raw": [
      {
        "anchor_text_raw": "Pathfinder Society Primer pg. 13",
        "href_raw": "http://paizo.com/products/btpy8yw6?Pathfinder-Player-Companion-Pathfinder-Society-Primer",
