  "entity_raw": {
    "name_raw": "Lingering Performance",
    "definition_type_raw": null,
    "source_book_raw": "Advanced Player’s Guide",
    "definition_raw": "The effects of your bardic performance carry on, even after you have stopped performing.\n\nPrerequisite: Bardic performance class feature.\n\nBenefit: The bonuses and penalties from your bardic performance continue for 2 rounds after you cease performing. Any other requirement, such as range or specific conditions, must still be met for the effect to continue. If you begin a new bardic performance during this time, the effects of the previous performance immediately cease.",
