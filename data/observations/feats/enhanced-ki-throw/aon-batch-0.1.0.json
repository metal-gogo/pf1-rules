  "entity_raw": {
    "name_raw": "Enhanced Ki Throw",
    "definition_type_raw": "Combat",
    "source_book_raw": "Dragon Empires Primer pg. 24",
    "definition_raw": "Source Dragon Empires Primer pg. 24\nYou enhance the force of your ki throws, enabling you to devastate your opponents as you slam them to the ground.\n\nPrerequisites: Ki pool class feature, Ki Throw (see the Pathfinder RPG Advanced Player’s Guide).\n\nBenefit: When using the Ki Throw feat, you can expend 1 ki point to amplify the force of your attack. If your ki throw succeeds, when the target hits the ground, it takes damage as if you had hit it with an unarmed strike.",
    "links_raw": [
      {
        "anchor_text_raw": "Dragon Empires Primer pg. 24",
        "href_raw": "http://paizo.com/products/btpy8pg0?Pathfinder-Player-Companion-Dragon-Empires-Primer",
        "href_resolved": "http://paizo.com/products/btpy8pg0?Pathfinder-Player-Companion-Dragon-Empires-Primer",
