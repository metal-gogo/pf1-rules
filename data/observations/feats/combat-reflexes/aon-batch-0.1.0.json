    "sections_raw": [
      {
        "heading_raw": "Benefit",
        "body_raw": "You may make a number of additional attacks of opportunity per round equal to your Dexterity bonus. With this feat, you may also make attacks of opportunity while flat-footed."
      },
      {
        "heading_raw": "Normal",
        "body_raw": "A character without this feat can make only one attack of opportunity per round and can't make attacks of opportunity while flat-footed."
      },
      {
        "heading_raw": "Special",
        "body_raw": "The Combat Reflexes feat does not allow a rogue to use her opportunist ability more than once per round."
      }
    ],
