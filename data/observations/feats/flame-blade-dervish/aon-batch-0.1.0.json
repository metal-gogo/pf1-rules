    "sections_raw": [
      {
        "heading_raw": "Prerequisites",
        "body_raw": "Ability to cast flame blade as a spell or spell-like ability."
      },
      {
        "heading_raw": "Benefit",
        "body_raw": "When you cast flame blade, you gain a +10 enhancement bonus to your base speed as long as the spell persists, along with a +4 competence bonus on all Acrobatics checks. You add your Charisma modifier to damage rolls with your flame blade, and ignore the first 10 points of fire resistance possessed by a creature you hit with the flame blade for the purposes of determining the damage dealt by the flame blade. Against undead foes, you ignore the first 30 points of fire resistance. Immunity to fire still completely protects against damage from your flame blade."
      }
    ],
