  "entity_raw": {
    "name_raw": "Consecrate Spell",
    "definition_type_raw": "Metamagic",
    "source_book_raw": "Blood of Angels pg. 25",
    "definition_raw": "Source Blood of Angels pg. 25\nYou infuse spells with heavenly power, drastically increasing their effectiveness against would-be heralds of evil.\n\nPrerequisites: Aasimar, able to prepare or cast consecrate.\n\nBenefit: A consecrated spell is treated as a maximized spell against evil creatures and creatures with the evil subtype. Against all other creatures, this feat does not modify the spell in any way (for example, a consecrated fireball acts as a normal fireball against neutral or good creatures). This feat does not stack with Maximize Spell. A consecrated spell uses up a spell slot two levels higher than the spell’s actual level.",
    "links_raw": [
      {
        "anchor_text_raw": "Blood of Angels pg. 25",
        "href_raw": "http://paizo.com/products/btpy8sa7?Pathfinder-Player-Companion-Blood-of-Angels",
