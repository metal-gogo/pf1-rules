    "sections_raw": [
      {
        "heading_raw": "Prerequisites",
        "body_raw": "Int or Cha 21, Hidden Presence, Manipulative Presence, ability to cast possession or greater possession."
      },
      {
        "heading_raw": "Benefit",
        "body_raw": "You can use detect thoughts at will as a spell-like ability against a host creature you possess. The host receives no saving throw, and the effect functions as if you had concentrated for 3 rounds. You can also use seek thoughts on your host as a spell-like ability once during the possession. The host can attempt a Will save with a DC equal to the DC of the original possession effect. If the host succeeds, the effect fails and the host become aware of the possession if it wasn’t already."
      }
    ],
