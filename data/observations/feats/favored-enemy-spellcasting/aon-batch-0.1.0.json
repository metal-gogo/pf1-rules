  "entity_raw": {
    "name_raw": "Favored Enemy Spellcasting",
    "definition_type_raw": null,
    "source_book_raw": "Advanced Class Guide pg. 147",
    "definition_raw": "Source Advanced Class Guide pg. 147\nYour spells are more effective against creatures that you especially abhor.\n\nPrerequisites: Ability to cast spells.\n\nBenefit: When you select this feat, choose a creature type or a humanoid subtype from the Ranger Favored Enemies table (Core Rulebook 64). When creatures of the chosen type attempt saving throws against your spells, they treat the spells’ DCs as 1 higher. If you also have the favored enemy class feature and the chosen type is already a favored enemy of yours, such creatures treat your spells’ DCs as 2 higher.\n\nSpecial: You can take this feat multiple times. Each time you do, it applies to a different creature type.",
    "links_raw": [
      {
        "anchor_text_raw": "Advanced Class Guide pg. 147",
