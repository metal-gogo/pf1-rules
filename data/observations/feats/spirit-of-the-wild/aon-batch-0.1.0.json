    "sections_raw": [
      {
        "heading_raw": "Prerequisites",
        "body_raw": "Attuned to the Wild, Guardian of the Wild, elf."
      },
      {
        "heading_raw": "Benefit",
        "body_raw": "When you are in a terrain type you have selected the Attuned to the Wild feat for, you gain a +4 bonus on Perception checks made to act in the surprise round of combat. If you act in the surprise round, you gain blindsense out to a range of 30 feet during the surprise round. If you are in an area that qualifies as more than one kind of terrain, these bonuses do not stack; you receive the bonus for only one terrain type."
      }
    ],
