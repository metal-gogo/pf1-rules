    "sections_raw": [
      {
        "heading_raw": "Prerequisites",
        "body_raw": "Craft Magic Arms and Armor, ability to cast consecrate or desecrate."
      },
      {
        "heading_raw": "Benefit",
        "body_raw": "When you craft a magic weapon, magic armor, or magic shield, you may add one casting of consecrate or desecrate as part of the item crafting process. This increases the item’s price by 250 gp. The item becomes a reliquary and can be used as a holy (or unholy) symbol divine focus of your deity. If you cast consecrate or desecrate, your reliquary counts as a permanent fixture for that spell while it remains in the spell’s area."
      }
    ],
