    "sections_raw": [
      {
        "heading_raw": "Prerequisites",
        "body_raw": "Bane class feature."
      },
      {
        "heading_raw": "Benefit",
        "body_raw": "You can use your bane class feature to imbue a melee weapon with the menacing special weapon ability (Advanced Player’s Guide 288) instead of bane. You can spend a swift action to switch between the two special weapon abilities. Doing so otherwise works according to your bane class feature."
      },
      {
        "heading_raw": "Special",
        "body_raw": "If you have the Double Bane feat, you can imbue each weapon you wield with either bane or menacing. No single weapon can have both."
      }
    ],
