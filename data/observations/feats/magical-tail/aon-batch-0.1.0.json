      },
      {
        "heading_raw": "Benefit",
        "body_raw": "You gain a new spell-like ability, each usable twice per day, from the following list, in order: disguise self, charm person, misdirection, invisibility, suggestion, displacement, confusion, dominate person. For example, the first time you select this feat, you gain disguise self 2/day; the second time you select this feat, you gain charm person 2/day. Your caster level for these spells is equal to your Hit Dice. The DCs for these abilities are Charisma-based."
      },
      {
        "heading_raw": "Special",
        "body_raw": "You may select this feat up to eight times. Each time you take it, you gain an additional ability as described above."
      }
