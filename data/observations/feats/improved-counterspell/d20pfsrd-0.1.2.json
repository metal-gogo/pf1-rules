  "entity_raw": {
    "name_raw": "Improved Counterspell",
    "definition_type_raw": null,
    "source_book_raw": "Pathfinder RPG Core Rulebook",
    "definition_raw": "You are skilled at countering the spells of others using similar spells.\n\nBenefit: When counterspelling, you may use a spell of the same school that is one or more spell levels higher than the target spell.\n\nNormal: Without this feat, you may counter a spell only with the same spell or with a spell specifically designated as countering the target spell.",
