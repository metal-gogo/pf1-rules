    "sections_raw": [
      {
        "heading_raw": "Prerequisites",
        "body_raw": "Weapon Focus (whip), Whip MasteryUC, base attack bonus +8."
      },
      {
        "heading_raw": "Benefit",
        "body_raw": "When you perform a dragAPG combat maneuver with your whip, you can choose not to move with your target, instead bringing your target closer to you. If you do this, you can’t drag the target any farther than the distance it takes to move it adjacent to you, even if your result was high enough to drag the target farther. You gain a +2 bonus on drag combat maneuver checks when using a whip to drag, but this bonus doesn’t stack with the bonus from Improved Drag."
      },
      {
        "heading_raw": "Special",
        "body_raw": "Balor Whip counts as Improved DragAPG for the purpose of qualifying for Quick DragUC."
      }
    ],
