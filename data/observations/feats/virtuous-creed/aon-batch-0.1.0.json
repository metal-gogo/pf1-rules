  "entity_raw": {
    "name_raw": "Virtuous Creed",
    "definition_type_raw": null,
    "source_book_raw": "Champions of Purity pg. 16",
    "definition_raw": "Source Champions of Purity pg. 16\nYou accept a creed to guide your destiny toward good.\n\nPrerequisites: You must be good.\n\nBenefit: Select one of the following virtues. You must adhere to that virtue’s creed in order to benefit from its bonus. If you break any part of the creed, you are unable to gain the benefits from that virtue for 24 hours. Significant violations require atonement for you to be able to benefit from this feat again.\n\nSpecial: You can gain this feat multiple times. Each time you take this feat, you must choose a new virtue.",
    "links_raw": [
      {
        "anchor_text_raw": "Champions of Purity pg. 16",
        "href_raw": "http://paizo.com/products/btpy8x1s?Pathfinder-Player-Companion-Champions-of-Purity\n",
