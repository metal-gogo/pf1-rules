      {
        "heading_raw": "Benefit",
        "body_raw": "If you are the only character threatening an opponent, you gain a +1 dodge bonus to AC against that opponent."
      },
      {
        "heading_raw": "Special",
        "body_raw": "The Artful Dodge feat acts as the Dodge feat for the purpose of satisfying prerequisites that require Dodge. You can use Intelligence, rather than Dexterity, for feats with a minimum Dexterity prerequisite."
      }
