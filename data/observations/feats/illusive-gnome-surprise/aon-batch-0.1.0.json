    "sections_raw": [
      {
        "heading_raw": "Prerequisites",
        "body_raw": "Int 13, Combat Expertise, Gnome Weapon FocusARG, Illusive Gnome Style, Improved Feint."
      },
      {
        "heading_raw": "Benefit",
        "body_raw": "While using Illusive Gnome Style, you gain a +2 bonus on combat maneuver checks to perform dirty tricksAPG and on Bluff checks to feint. In addition, when you successfully use Bluff to feint against a foe, instead of denying that foe its Dexterity bonus to AC, you can treat one “gnome” weapon that you are wielding as if it had one of the following weapon special features: blockingUC, brace, disarm, distractingUC, performanceUC, sunder, or trip. This benefit applies only against that foe and lasts for a number of rounds equal to your Charisma modifier (minimum 1)."
      }
    ],
