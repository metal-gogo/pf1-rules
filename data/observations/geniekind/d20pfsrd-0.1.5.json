    "levels_raw": "cleric 5, druid 5, sorcerer/wizard 5, summoner 5",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a pinch of dust, embers, wind-blown sand or drops of water, depending on the genie type)",
    "range_raw": "personal",
