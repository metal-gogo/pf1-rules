  "spell_raw": {
    "name_raw": "Speak with Plane",
    "alternate_names_raw": [],
    "school_raw": "divination",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "cleric 4, medium 3, shaman 4, sorcerer/wizard 4, summoner 3, witch 4",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, F/DF (a small glass bead)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one plane with a sentient structure",
        "kinds": [
          "target"
        ]
      }
    ],
    "duration_raw": "1 minute/level",
    "saving_throw_raw": "Will negates (see text)",
    "spell_resistance_raw": "yes",
    "description_raw": "You tap into the awareness and consciousness of a plane with a sentient structure, allowing it to answer questions. A tangible manifestation of the plane (such as the ground) must be within the spell’s range upon casting.\n\nYou can ask the sentient plane one question per 2 caster levels.\n\nIf the plane’s alignment is at least one step away from yours, the plane can attempt a Will save to resist the spell. A plane typically has a +20 bonus on Will saves, and a demiplane typically has a +15 bonus on Will saves. A plane’s traits can further affect these bonuses: a mildly aligned plane receives a +2 bonus, and a strongly aligned plane or a plane with the wild magic trait receives a +4 bonus on its save.\n\nIf a plane has been subject to this spell within the past week, a new casting of this spell targeting the same plane fails. If speak with plane targets a plane that does not have a sentient structure, the spell fails.",
