    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M/DF (a charred animal or humanoid skull fragment)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Effect",
        "value_raw": "a sheet of flame up to 15 ft. long and 10 ft. high that moves 15 ft. in a straight line.",
        "kinds": [
          "effect"
        ]
      }
    ],
    "duration_raw": "instantaneous",
    "saving_throw_raw": "Reflex half and Will negates (see text)",
    "spell_resistance_raw": "yes",
    "description_raw": "A sheer wall of flame appears and rushes away from you.\n\nTendrils of fire reach out of it, shaped into skulls screaming in agony. When the wall passes through a creature’s space, that creature must succeed at a Reflex save or take 1d8 points of fire damage for every 2 caster levels you have (maximum 5d8). Any creature taking fire damage must also succeed at a Will save or take 1d3 points of Wisdom damage. Deaf creatures receive a +4 circumstance bonus on their Will saves.\n\nIf your campaign uses the sanity rules, a creature takes 1d6 points of sanity damage instead of Wisdom damage.",
