    "levels_raw": "bard 4, cleric 4, inquisitor 4, medium 3, occultist 4, paladin 4, psychic 5, sorcerer/wizard 5, spiritualist 4, witch 5",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a black candle), F (a corpse slain no more than 1 day ago per caster level)",
    "range_raw": "see text",
    "delivery_fields_raw": [
      {
