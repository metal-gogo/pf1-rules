    "levels_raw": "alchemist 6, sorcerer/wizard 7",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a piece of the creature whose form you plan to assume)",
    "range_raw": "personal",
