  "spell_raw": {
    "name_raw": "Fey Form III",
    "alternate_names_raw": [],
    "school_raw": "transmutation (polymorph)",
    "subschool_raw": "polymorph",
    "descriptors_raw": [],
    "levels_raw": "alchemist 6, druid 6, shaman 6, sorcerer/wizard 7, witch 7",
