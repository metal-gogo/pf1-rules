    "name_raw": "Unhallowed Blows",
    "alternate_names_raw": [],
    "school_raw": "transmutation [evil]",
    "subschool_raw": null,
    "descriptors_raw": [
      "evil"
    ],
    "levels_raw": "antipaladin 1, cleric 1, inquisitor 1, sorcerer/wizard 1, witch 1",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M/DF (a pinch of dust from a destroyed undead creature)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one undead creature/level, no two of which can be more than 30 ft. apart",
        "kinds": [
          "target"
        ]
      }
    ],
    "duration_raw": "1 minute/level",
    "saving_throw_raw": "Will negates (harmless)",
    "spell_resistance_raw": "yes (harmless)",
    "description_raw": "This spell empowers the natural attacks or unarmed strikes of undead creatures, granting a +1 enhancement bonus on attack and damage rolls made by the target with its unarmed strikes or attacks with one natural attack. This spell can cause an undead creature’s unarmed strike to deal lethal damage, but in this case, the attack does not gain an enhancement bonus.\n\nUnhallowed blows can be made permanent with a permanency spell. In this case, the caster must be at least 9th level and must expend 2,500 gp worth of diamond dust as a material component.\n\nUnhallowed Blows, Greater\nSchool transmutation [evil]; Level antipaladin 3, cleric 3, inquisitor 3, sorcerer/wizard 3, witch 3",
