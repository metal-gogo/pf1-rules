  "spell_raw": {
    "name_raw": "Polymorph",
    "alternate_names_raw": [],
    "school_raw": "transmutation (polymorph)",
    "subschool_raw": "polymorph",
    "descriptors_raw": [],
    "levels_raw": "alchemist 5, sorcerer/wizard 5",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a piece of the creature whose form you choose)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "living creature touched",
        "kinds": [
          "target"
        ]
