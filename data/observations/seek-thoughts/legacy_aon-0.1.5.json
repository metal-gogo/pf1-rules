    "levels_raw": "alchemist 3, bard 3, inquisitor 3, sorcerer/wizard 3, summoner 3, witch 3",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a handful of copper coins)",
    "range_raw": "40 ft.",
    "delivery_fields_raw": [
      {
        "label_raw": "Area",
