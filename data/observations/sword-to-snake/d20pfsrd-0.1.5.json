  "spell_raw": {
    "name_raw": "Sword to Snake",
    "alternate_names_raw": [],
    "school_raw": "transmutation [poison]",
    "subschool_raw": null,
    "descriptors_raw": [
      "poison"
    ],
    "levels_raw": "cleric 4, druid 4, shaman 4, sorcerer/wizard 4, summoner 4",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M/DF (a hair from a spider)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one Medium or smaller item",
        "kinds": [
          "target"
        ]
      }
    ],
    "duration_raw": "1 round/level (D)",
    "saving_throw_raw": "Will negates (object)",
    "spell_resistance_raw": "yes (object)",
    "description_raw": "When you make an undulating gesture using your hand, the target item changes slightly in shape and appearance to resemble a cross between its original form and that of a venomous animal.\n\nFor example, a staff might change to resemble a snake, a shield might change to resemble an enormous venomous beetle, or the hilt of a sword might change to resemble a scorpion’s tail.\n\nIf this spell is cast on a held item, the wielder adds his Will save bonus to the saving throw. You must be able to see the item to cast this spell on it. The item retains all its properties, but whenever a creature picks up, attacks with, activates, or otherwise manipulates the item (with the exception of dropping the item) after this spell is cast, it animates and bites the creature. The attack is resolved before the action that triggered it. This spell otherwise does not affect the creature’s ability to use the item.\nIf the item is a non-magical weapon, it has an attack bonus equal to your caster level plus your spellcasting ability score modifier, and its attack deals 1d4 points of piercing damage.\nIf the target item is a magic weapon, it retains any magical qualities, and its enhancement bonus is still added to both the attack roll and the damage roll.\n\nA creature that takes damage from the bite is affected as if by a venomous snake‘s poison (frequency 1/round for 6 rounds; effect 1d2 Con; cure 1 save). The poison’s save DC is equal to this spell’s DC.",
