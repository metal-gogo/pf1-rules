    "levels_raw": "cleric 4, inquisitor 4, sorcerer/wizard 4",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a single link from a spiked chain)",
    "range_raw": "0 ft.",
    "delivery_fields_raw": [
      {
        "label_raw": "Effect",
        "value_raw": "spiked chain-like shadowy weapon",
