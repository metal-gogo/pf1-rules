    "casting_time_raw": "1 round",
    "components_raw": "V, S, M (a drop of blood from each of three different creatures)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one Small or larger living creature",
