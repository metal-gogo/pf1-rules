  "spell_raw": {
    "name_raw": "Nondetection",
    "alternate_names_raw": [],
    "school_raw": "abjuration",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "alchemist 3, antipaladin 3, inquisitor 3, medium 2, mesmerist 3, occultist 3, psychic 3, ranger 4, sorcerer/wizard 3, spiritualist 3, summoner/unchained summoner 3",
    "domains_raw": "trickery 3",
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (diamond dust worth 50 gp)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "creature or object touched",
