  "spell_raw": {
    "name_raw": "Flesh Puppet",
    "alternate_names_raw": [],
    "school_raw": "necromancy [evil]",
    "subschool_raw": null,
    "descriptors_raw": [
      "evil"
    ],
    "levels_raw": "antipaladin 2, cleric 3, occultist 3, shaman 3, sorcerer/wizard 4, spiritualist 3, witch 4",
    "domains_raw": null,
    "casting_time_raw": "1 round",
    "components_raw": "V, S, M (an onyx worth 25 gp and a silken string)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
