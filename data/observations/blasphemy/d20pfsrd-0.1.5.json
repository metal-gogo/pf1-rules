    "levels_raw": "cleric/oracle 7, inquisitor 6",
    "domains_raw": "evil 7",
    "casting_time_raw": "1 standard action",
    "components_raw": "V",
    "range_raw": "40 ft.",
    "delivery_fields_raw": [
      {
        "label_raw": "Area",
        "value_raw": "nonevil creatures in a 40-ft.-radius spread centered on you",
