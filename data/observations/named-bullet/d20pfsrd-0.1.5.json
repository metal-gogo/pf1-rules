  "spell_raw": {
    "name_raw": "Named Bullet",
    "alternate_names_raw": [],
    "school_raw": "divination",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "inquisitor 4, ranger 3, sorcerer/wizard 4, witch 4",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M/DF (an item from the selected creature or creature type)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one piece of ammunition or one thrown weapon",
        "kinds": [
          "target"
        ]
      }
    ],
    "duration_raw": "10 minutes/level or until discharged",
    "saving_throw_raw": "Will negates (harmless, object)",
    "spell_resistance_raw": "yes (harmless, object)",
    "description_raw": "You imbue the target with deadly accuracy against a selected creature type (and subtype for humanoids or outsiders) or a specific creature you know and can name. When used against the selected creature, the ammunition never misfires and is unaffected by concealment (but not total concealment), and at a range of 30 feet or less, the attack targets the selected creature’s touch AC. When the target hits the selected creature, you must overcome that creature’s spell resistance, or this spell has no effect. A normal hit scored using the target against the selected creature is considered to be a critical threat and deals 1 extra point of damage per caster level (maximum 20), which is not multiplied on a critical hit. A natural critical hit deals the same extra damage, but that damage is multiplied due to the critical.\n\nOnce the target is used to attack the selected creature, successfully or not, this spell is discharged.\n\nNamed Bullet, Greater\nLevel inquisitor 6, ranger 4, sorcerer/wizard 6, witch 6\n\nThis spell functions like named bullet, except it deals 2 extra points of damage per caster level (maximum 40).",
