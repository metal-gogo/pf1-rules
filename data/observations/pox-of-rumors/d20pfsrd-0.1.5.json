    "levels_raw": "bard 5, cleric 7, mesmerist 5, psychic 7, sorcerer/wizard 7, spiritualist 5, witch 7",
    "domains_raw": null,
    "casting_time_raw": "8 hours",
    "components_raw": "V, S, M (a physical connection to the target; see text)",
    "range_raw": "see text",
    "delivery_fields_raw": [
      {
