    ],
    "levels_raw": "bloodrager 3, cleric/oracle 3, psychic 3, sorcerer/wizard 3",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M/DF (chain link)",
