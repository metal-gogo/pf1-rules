    "levels_raw": "bard 2, cleric 2, inquisitor 2, magus 2, occultist 2, shaman 2, sorcerer/wizard 2",
    "domains_raw": null,
    "casting_time_raw": "1 round",
    "components_raw": "V, S, M (a patch of white cloth and a patch of black cloth)",
    "range_raw": "medium (100 ft. + 10 ft./level)",
    "delivery_fields_raw": [
      {
        "label_raw": "Area",
        "value_raw": "contiguous area consisting of one 10-foot cube/level (S)",
