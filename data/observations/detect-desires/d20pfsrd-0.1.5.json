      "mind-affecting"
    ],
    "levels_raw": "antipaladin 2, bard 2, cleric 3, inquisitor 3, medium 2, mesmerist 3, paladin 3, psychic 2, sorcerer/wizard 3, spiritualist 3, witch 3",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, F/DF (a medallion)",
    "range_raw": "60 ft.",
    "delivery_fields_raw": [
      {
