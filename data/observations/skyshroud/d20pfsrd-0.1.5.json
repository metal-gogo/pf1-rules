    "name_raw": "Skyshroud",
    "alternate_names_raw": [],
    "school_raw": "divination (scrying)",
    "subschool_raw": "scrying",
    "descriptors_raw": [],
    "levels_raw": "arcanist 3, bard 3, cleric/oracle 3, skald 3, sorcerer/wizard 3, warpriest 3",
    "domains_raw": null,
    "casting_time_raw": "1 minute",
    "components_raw": "V, S, F (a jar of earth from the surface)",
    "range_raw": "long (400 ft. + 40 ft./level); see text",
    "delivery_fields_raw": [
      {
        "label_raw": "Effect",
        "value_raw": "hemisphere that cannot extend beyond four 10-ft. cubes + one 10-ft. cube/level (S)",
        "kinds": [
          "effect"
        ]
      }
    ],
    "duration_raw": "1 hour/level",
    "saving_throw_raw": "none",
    "spell_resistance_raw": "no",
    "description_raw": "The caster designates the area of a hemisphere within the spell’s range. If a solid object would block the creation of the hemisphere (such as a ceiling or wall), the spell instead conforms to the geometry of the location up to the maximum area of effect for the spell. The hemisphere displays an image of the sky as it appears directly above where the spell was cast. This effect bypasses natural impediments, such as rock or stone, that would obstruct the targeted location from the sky.\n\nThe image of the sky created by this spell counts as the actual sky for purposes of effects that require view of the sky, sun, stars, or other features (including for spell preparation or deific obediences). It does not enable spells or effects that draw effects from the sky (such as call lightning).\n\nLight created by this effect functions normally and harms creatures vulnerable to bright light or direct sunlight.",
