  "spell_raw": {
    "name_raw": "Green Caress",
    "alternate_names_raw": [],
    "school_raw": "transmutation",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "druid 6, ranger 4, shaman 6, witch 6",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (pinch of moss or a kudzu leaf)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
