    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a knife suitable for whittling)",
    "range_raw": "medium (100 ft. + 10 ft./level)",
    "delivery_fields_raw": [
      {
        "label_raw": "Targets",
        "value_raw": "1 or more pieces of wood, no two of which can be more than 30 ft. apart",
