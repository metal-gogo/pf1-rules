    "levels_raw": "antipaladin 2, bard 2, inquisitor 2, paladin 2, psychic 2, ranger 2, sorcerer/wizard 2, witch 2",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, F (one to four adamantine bullets, each worth 61 gp)",
    "range_raw": "personal",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
