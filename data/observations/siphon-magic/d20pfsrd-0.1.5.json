    "levels_raw": "cleric 5, sorcerer/wizard 5, witch 5",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a coiled length of copper wire wrapped around the palm)",
    "range_raw": "touch",
    "delivery_fields_raw": [
