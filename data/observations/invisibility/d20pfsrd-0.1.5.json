  "spell_raw": {
    "name_raw": "Invisibility",
    "alternate_names_raw": [],
    "school_raw": "illusion (glamer)",
    "subschool_raw": "glamer",
    "descriptors_raw": [],
    "levels_raw": "alchemist 2, antipaladin 2, bard 2, inquisitor 2, magus 2, medium 2, mesmerist 2, occultist 2, psychic 2, sorcerer/wizard 2, spiritualist 2, summoner/unchained summoner 2",
    "domains_raw": "trickery 2",
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M/DF (an eyelash encased in gum arabic)",
    "range_raw": "personal or touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "you or a creature or object weighing no more than 100 lbs./level",
        "kinds": [
          "target"
        ]
      },
      {
        "label_raw": "Targets",
        "value_raw": "any number of creatures, no two of which can be more than 180 ft. apart",
