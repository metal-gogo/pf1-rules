    ],
    "levels_raw": "arcanist 5, bard 6, cleric 5, druid 5, hunter 5, oracle 5, psychic 6, shaman 5, skald 6, sorcerer 5, warpriest 5, witch 6, wizard 5",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a bit of seaweed)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "nonhostile creature touched",
