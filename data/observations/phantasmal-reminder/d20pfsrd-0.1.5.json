    "name_raw": "Phantasmal Reminder",
    "alternate_names_raw": [],
    "school_raw": "illusion (phantasm)) [mind-affecting]",
    "subschool_raw": "phantasm",
    "descriptors_raw": [
      "mind-affecting"
    ],
    "levels_raw": "antipaladin 3, bard 4, mesmerist 3, psychic 3, shaman 4, sorcerer/wizard 3, witch 3",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S",
    "range_raw": "medium (100 ft. + 10 ft./level)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
