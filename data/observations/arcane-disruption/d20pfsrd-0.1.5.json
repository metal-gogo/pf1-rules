    ],
    "levels_raw": "bard 2, bloodrager 2, magus 2, sorcerer/wizard 2, witch 2",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a pinch of pepper)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one creature",
