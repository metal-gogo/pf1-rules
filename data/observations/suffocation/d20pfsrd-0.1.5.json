    "levels_raw": "sorcerer/wizard 5, witch 5",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a vial containing a bit of the caster’s breath)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Targets",
        "value_raw": "one living creature",
