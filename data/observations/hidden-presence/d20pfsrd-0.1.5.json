    "descriptors_raw": [
      "mind-affecting"
    ],
    "levels_raw": "bard 2, inquisitor 2, mesmerist 2, psychic 2, sorcerer/wizard 2, witch 2",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (eye drops made with extract of poppy)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "up to one creature per 3 caster levels",
