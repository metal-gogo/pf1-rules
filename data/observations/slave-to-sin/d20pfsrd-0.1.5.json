    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M/DF (a scrap of paper inscribed with a sin rune)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
