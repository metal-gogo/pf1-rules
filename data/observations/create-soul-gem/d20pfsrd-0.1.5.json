    "levels_raw": "cleric 3, occultist 3, shaman 3, sorcerer/wizard 3, spiritualist 3, witch 3",
    "domains_raw": null,
    "casting_time_raw": "1 round",
    "components_raw": "V, S, F (crystal lens worth 500 gp)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
