  "spell_raw": {
    "name_raw": "Black Tentacles",
    "alternate_names_raw": [],
    "school_raw": "conjuration (creation)",
    "subschool_raw": "creation",
    "descriptors_raw": [],
    "levels_raw": "bloodrager 4, magus 4, sorcerer/wizard 4, summoner 3, unchained summoner 4, witch 4",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (octopus or squid tentacle)",
    "range_raw": "medium (100 ft. + 10 ft./level)",
    "delivery_fields_raw": [
      {
        "label_raw": "Area",
        "value_raw": "20-ft.-radius spread",
        "kinds": [
