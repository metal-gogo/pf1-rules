    "levels_raw": "cleric 1, inquisitor 1, paladin 1, shaman 1, sorcerer/wizard 1, spiritualist 1, summoner 1, witch 1",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Area",
