  "spell_raw": {
    "name_raw": "Appearance of Life",
    "alternate_names_raw": [],
    "school_raw": "illusion (glamer) [evil]",
    "subschool_raw": "glamer",
    "descriptors_raw": [
      "evil"
    ],
    "levels_raw": "cleric/oracle 3, medium 2, mesmerist 3, psychic 3, sorcerer/wizard 3, spiritualist 3, witch 3",
    "domains_raw": null,
    "casting_time_raw": "1 round",
    "components_raw": "V, S, M (one Tiny or larger living creature)",
    "range_raw": "long (400 ft. + 40 ft./caster level)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one or more undead creatures",
        "kinds": [
          "target"
        ]
      }
    ],
    "duration_raw": "10 minutes/level (D)",
    "saving_throw_raw": "Will disbelief or Will negates (see text)",
    "spell_resistance_raw": "no",
    "description_raw": "The illusion makes undead creatures of Medium size or smaller appear as if they were living humanoid creatures. You can target a number of undead creatures whose total number of Hit Dice is no greater than twice your caster level. When you create the illusion, you choose the races, genders, and attire for the undead creatures. Additionally, the illusion makes the undead creatures’ movements appear lifelike (two shuffling zombies could be made to appear as two strolling lovers). The illusion doesn’t create smell, sound, texture, or temperature. Undead with Intelligence scores can attempt a saving throw to negate the effect of the spell, but mindless undead do not. Any creatures interacting with the illusion receive a saving throw to disbelieve the illusion.\n\nThe illusion interferes with detect undead, requiring the caster to succeed at a caster check (DC = 11 + your caster level) for the spell to determine the creatures are undead.\n\nAppearance of life can be made permanent with a permanency spell by a caster of 12th level or higher for the cost of 10,000 gp.",
