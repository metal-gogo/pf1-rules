    "levels_raw": "bard 4, mesmerist 4, psychic 5, sorcerer/ wizard 5, witch 5",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "S, V, M (a shiny bead)",
    "range_raw": "long (400 ft. + 40 ft./level)",
    "delivery_fields_raw": [
      {
