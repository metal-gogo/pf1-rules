  "spell_raw": {
    "name_raw": "Loathsome Veil",
    "alternate_names_raw": [],
    "school_raw": "illusion (pattern) [mind-affecting]",
    "subschool_raw": "pattern",
    "descriptors_raw": [
      "mind-affecting"
    ],
    "levels_raw": "mesmerist 3, psychic 3, sorcerer/ wizard 3, witch 3",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a tangle of multicolored threads)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Effect",
        "value_raw": "transparent pattern 40 ft. long, 20 ft. high",
        "kinds": [
