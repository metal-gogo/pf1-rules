    "descriptors_raw": [],
    "levels_raw": "alchemist 5, sorcerer/wizard 5, summoner 4, unchained summoner 5, witch 5; Bloodline harrow 5; Mystery ascetic 5, juju(PZO9436) 6, lore 5, occult 5",
    "domains_raw": null,
    "casting_time_raw": "10 minutes",
