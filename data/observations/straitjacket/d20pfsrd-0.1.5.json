    "levels_raw": "inquisitor 4, occultist 4, sorcerer/wizard 5, summoner 5",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (leather strap)",
    "range_raw": "close (25 ft. + 5 ft./2 caster levels)",
    "delivery_fields_raw": [
      {
