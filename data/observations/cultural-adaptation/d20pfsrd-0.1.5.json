  "spell_raw": {
    "name_raw": "Cultural Adaptation",
    "alternate_names_raw": [],
    "school_raw": "divination",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "bard 1, cleric 1, medium 1, occultist 1, psychic 1, sorcerer/wizard 1",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M/DF (a document written in the language of the culture to be emulated)",
    "range_raw": "personal",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "you",
        "kinds": [
          "target"
