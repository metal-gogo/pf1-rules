    "name_raw": "Skeleton Crew",
    "alternate_names_raw": [],
    "school_raw": "necromancy",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "cleric 3, sorcerer/wizard 4, summoner 4, witch 4",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M",
    "range_raw": "touch",
    "delivery_fields_raw": [
