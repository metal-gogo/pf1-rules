    "levels_raw": "alchemist 4, cleric/oracle 4, inquisitor 4, paladin 4, shaman 4; Mystery life 4",
    "domains_raw": null,
    "casting_time_raw": "3 rounds",
    "components_raw": "V, S, M (diamond dust worth 100 gp or 1,000 gp, see text)",
