  "spell_raw": {
    "name_raw": "Reduce Person",
    "alternate_names_raw": [],
    "school_raw": "transmutation",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "alchemist 1, bloodrager 1, magus 1, psychic 1, sorcerer/wizard 1, summoner/unchained summoner 1, witch 1",
    "domains_raw": null,
    "casting_time_raw": "1 round",
    "components_raw": "V, S, M (a pinch of powdered iron)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
