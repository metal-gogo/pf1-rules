  "spell_raw": {
    "name_raw": "Erase Impressions",
    "alternate_names_raw": [],
    "school_raw": "abjuration",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "medium 3, mesmerist 4, occultist 3, psychic 5, spiritualist 4",
    "domains_raw": null,
    "casting_time_raw": "1 round",
    "components_raw": "V, S",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "object touched",
        "kinds": [
          "target"
        ]
      }
    ],
    "duration_raw": "instantaneous",
    "saving_throw_raw": "Will negates (object)",
    "spell_resistance_raw": "yes (object)",
    "description_raw": "You banish psychic impressions from the object touched, rendering it devoid of recent history. You choose how much time to erase, up to a maximum of 1 day per caster level.\n\nYou must erase impressions from the present time back; you cannot choose to leave recent events untouched. Impressions erased in this manner cannot be recovered via object reading, legend lore, or similar measures.\n\nCasting erase impressions on a corpse removes recent psychic impressions from when the creature was alive as well, making those memories unavailable to speak with dead. For example, a 5th-level caster casting the spell on a 2-day-old corpse could erase the past 2 days of psychic impressions from the corpse and 3 additional days of information from just before the creature died.",
