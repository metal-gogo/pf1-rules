    "name_raw": "Form of the Dragon I",
    "alternate_names_raw": [],
    "school_raw": "transmutation (polymorph)",
    "subschool_raw": "polymorph",
    "descriptors_raw": [],
    "levels_raw": "alchemist 6, magus 6, sorcerer/wizard 6",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a scale of the dragon type you plan to assume)",
    "range_raw": "personal",
