  "spell_raw": {
    "name_raw": "Make Whole",
    "alternate_names_raw": [],
    "school_raw": "transmutation",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "cleric/oracle 2, occultist 2, psychic 2, sorcerer/wizard 2",
    "domains_raw": null,
    "casting_time_raw": "10 minutes",
    "components_raw": "V, S",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one object of up to 10 cu. ft./level or one construct creature of any size",
        "kinds": [
          "target"
        ]
      }
    ],
    "duration_raw": "instantaneous",
    "saving_throw_raw": ": Will negates (harmless, object)",
    "spell_resistance_raw": ": yes (harmless, object)",
    "description_raw": "This spell functions as mending, except that it repairs 1d6 points of damage per level when cast on an object or construct creature (maximum 5d6).\n\nMake whole can fix destroyed magic items (at 0 hit points or less), and restores the magic properties of the item if your caster level is at least twice that of the item. Items with charges (such as wands) and single-use items (such as potions and scrolls) cannot be repaired in this way. When make whole is used on a construct creature, the spell bypasses any immunity to magic as if the spell did not allow spell resistance.\n\nMake Whole, Greater\nSchool transmutation; Level cleric/oracle 4, sorcerer/wizard 4",
