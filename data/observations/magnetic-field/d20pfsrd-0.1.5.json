    "levels_raw": "alchemist 6, cleric 7, magus 6, sorcerer/wizard 7, summoner 6, witch 7",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S",
    "range_raw": "30 ft.",
    "delivery_fields_raw": [
      {
        "label_raw": "Area",
