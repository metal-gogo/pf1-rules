  "spell_raw": {
    "name_raw": "Detect Magic",
    "alternate_names_raw": [],
    "school_raw": "divination",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "bard 0, cleric/oracle 0, druid 0, inquisitor 0, magus 0, psychic 0, shaman 0, sorcerer/wizard 0, summoner/unchained summoner 0, witch 0",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S",
    "range_raw": "60 ft.",
    "delivery_fields_raw": [
      {
        "label_raw": "Area",
        "value_raw": "cone-shaped emanation",
