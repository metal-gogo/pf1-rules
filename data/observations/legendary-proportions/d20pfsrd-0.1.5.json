    "levels_raw": "alchemist 6, druid 7, shaman 7, sorcerer/wizard 7, witch 7",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a dinosaur bone and powdered amber worth at least 200 gp)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
