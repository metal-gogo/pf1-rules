  "spell_raw": {
    "name_raw": "True Seeing",
    "alternate_names_raw": [],
    "school_raw": "divination",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "alchemist 6, cleric/oracle 5, druid 7, inquisitor 5, magus 6, shaman 5, sorcerer/wizard 6, summoner 5, unchained summoner 6, witch 6",
    "domains_raw": "knowledge 5",
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (an eye ointment that costs 250 gp)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
