    "levels_raw": "cleric 5, magus 5, sorcerer/wizard 5, witch 5",
    "domains_raw": null,
    "casting_time_raw": "10 minutes",
    "components_raw": "V, S, M (a masterwork melee weapon costing at least 300 gp)",
    "range_raw": "0 ft.; see text",
