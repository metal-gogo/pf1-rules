    "levels_raw": "druid 2",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a queen ant)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Targets",
        "value_raw": "one creature/level, no two of which can be more than 30 ft. apart",
        "kinds": [
          "target"
        ]
      }
    ],
    "duration_raw": "1 hour/level",
    "saving_throw_raw": "Fortitude negates (harmless)",
    "spell_resistance_raw": "yes (harmless)",
    "description_raw": "You, or a willing creature you touch, lay down a trail of scents that only the creatures you designate at the time of can detect. These creatures find it very easy to follow this trail.\n\nThey gain a +20 competence bonus on any Survival checks made for the purpose of tracking the creature laying this trail.\n\nSubject creatures with the scent special ability gain a +10 competence bonus on Wisdom or Survival checks to follow the trail.\n\nIn addition, you can leave scent messages along the trail.\n\nEach word or emotion in this message requires spending a move action in the same spot. Subject creatures seeking to understand this message must make another DC 20 Survival check, with a -1 penalty for every word or emotion in the message, in order to understand it. Creatures cannot benefit from this smell if they cannot use, or do not have, a sense of smell. Creatures can use this spell to backtrack through a dungeon, maze, or similar areas even if the creature laying down the trail crossed over the spot multiple times.",
