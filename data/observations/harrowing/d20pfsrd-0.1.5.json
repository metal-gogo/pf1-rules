  "spell_raw": {
    "name_raw": "Harrowing",
    "alternate_names_raw": [],
    "school_raw": "divination",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "bard 3, shaman 3, sorcerer/wizard 3, witch 3; Bloodline harrow 3",
    "domains_raw": null,
    "casting_time_raw": "10 minutes",
    "components_raw": "V, S, F (a Harrow deck)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one creature",
        "kinds": [
