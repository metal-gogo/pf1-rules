    "levels_raw": "antipaladin 3, cleric 4, psychic 4, shaman 4, sorcerer/wizard 4, spiritualist 4, witch 4",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M/DF (a ghoul fang)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
