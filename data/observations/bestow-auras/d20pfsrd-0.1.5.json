    "levels_raw": "antipaladin 3, paladin 3",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
