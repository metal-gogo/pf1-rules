  "spell_raw": {
    "name_raw": "Maze of Madness and Suffering",
    "alternate_names_raw": [],
    "school_raw": "conjuration (teleportation) [evil, mind-affecting]",
    "subschool_raw": "teleportation",
    "descriptors_raw": [
