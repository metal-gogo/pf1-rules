    "levels_raw": "psychic 9, sorcerer/wizard 9, witch 9",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (an ornate puzzle box worth 1,000 gp and soaked in fresh blood)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
