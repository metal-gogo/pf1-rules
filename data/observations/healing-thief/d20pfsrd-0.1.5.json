  "spell_raw": {
    "name_raw": "Healing Thief",
    "alternate_names_raw": [],
    "school_raw": "necromancy Level mesmerist 1, occultist 3, psychic 3, sorcerer/wizard 3, witch 3",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "mesmerist 1, occultist 3, psychic 3, sorcerer/wizard 3, witch 3",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a bit of sponge, damp with tears)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "creature touched",
