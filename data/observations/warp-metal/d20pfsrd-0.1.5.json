    ],
    "levels_raw": "bloodrager 4, cleric 4, druid 4, medium 4, occultist 4, psychic 4, sorcerer/wizard 4",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a twisted wire)",
    "range_raw": "close (25 ft. plus 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Targets",
        "value_raw": "1 Small metal object/level, all within a 20-ft. radius; see text",
