    "levels_raw": "alchemist 5, magus 5, sorcerer/wizard 5",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a piece of the creature whose form you plan to grant)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "willing living creature touched",
        "kinds": [
