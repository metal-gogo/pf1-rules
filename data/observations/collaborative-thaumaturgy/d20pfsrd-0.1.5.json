    "levels_raw": "bard 3, cleric 3, druid 3, magus 3, summoner 3, sorcerer/wizard 3, witch 3",
    "domains_raw": null,
    "casting_time_raw": "1 immediate action",
    "components_raw": "V, S, F (a bronze tuning fork)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
