    ],
    "levels_raw": "bloodrager 3, magus 4, occultist 4, sorcerer/wizard 4",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a pinch of coal)",
    "range_raw": "medium (100 ft. + 10 ft./level)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one creature",
