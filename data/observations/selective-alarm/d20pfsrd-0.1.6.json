    "levels_raw": "bard 3, inquisitor 3, occultist 3, psychic 3, ranger 2, sorcerer/wizard 3, spiritualist 3, summoner 3",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, F/DF (a slender iron rod 1 foot in length)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Area",
        "value_raw": "up to 20-ft.-radius emanation centered on a point in space",
