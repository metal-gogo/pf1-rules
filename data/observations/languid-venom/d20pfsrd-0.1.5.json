    ],
    "levels_raw": "alchemist 2, shaman 2, sorcerer/wizard 2",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (herbs used in antitoxins worth 25 gp)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one dose of poison or one venomous creature",
