    "levels_raw": "cleric/oracle 7, sorcerer/wizard 7, witch 7",
    "domains_raw": null,
    "casting_time_raw": "1 round",
    "components_raw": "V, S, M (the powdered bones of a creature that died in prison)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one creature",
