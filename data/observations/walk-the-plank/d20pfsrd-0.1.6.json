  "spell_raw": {
    "name_raw": "Walk the Plank",
    "alternate_names_raw": [],
    "school_raw": "conjuration (creation)",
    "subschool_raw": "creation",
    "descriptors_raw": [],
    "levels_raw": "arcanist 5, sorcerer/wizard 5, summoner 5, summoner (unchained) 5",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a shark tooth and a splinter of a ship’s hull)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Effect",
        "value_raw": "20-ft.-by-20-ft. hole, 10 ft. deep/4 levels",
        "kinds": [
          "effect"
        ]
      }
    ],
    "duration_raw": "1 round plus 1 round/level",
    "saving_throw_raw": "Reflex negates (see text)",
    "spell_resistance_raw": "no",
    "description_raw": "This spell functions as per create pit, except as noted here. All but the top 10 feet of the hole is filled with saltwater, reducing the fall damage for anyone falling into the pit to 1d3 points of nonlethal damage and allowing Huge or larger creatures at the water’s surface to simply pull themselves out of the pit as part of a normal move action, without a Climb check. Additionally, the pit contains a single advanced shark for every 4 caster levels you have (maximum four advanced sharks). If desired, when you cast the spell, you can substitute two of the summoned sharks for one great white shark. These sharks immediately attack any creature that falls into the pit, even you. If multiple creatures fall in the pit, the sharks attack randomly. When the spell ends, creatures inside the hole rise up with the bottom of the pit, as normal for create pit, but the conjured water and sharks vanish.",
