    "levels_raw": "cleric/oracle 2, inquisitor 2",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a vial of holy water and 25 gp worth of silver dust), DF",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Area",
        "value_raw": "20-ft.-radius emanation",
