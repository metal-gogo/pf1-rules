      "mind-affecting"
    ],
    "levels_raw": "antipaladin 1, cleric/oracle 1, inquisitor 1, psychic 1, witch 1",
    "domains_raw": "nobility 5",
    "casting_time_raw": "1 standard action",
    "components_raw": "V",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
