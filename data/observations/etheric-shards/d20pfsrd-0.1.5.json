    ],
    "levels_raw": "occultist 4, psychic 5, spiritualist 4",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "S, M (broken glass)",
    "range_raw": "medium (100 ft. + 10 ft./level)",
    "delivery_fields_raw": [
      {
        "label_raw": "Area",
