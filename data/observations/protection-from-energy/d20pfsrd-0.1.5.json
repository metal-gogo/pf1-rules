    "descriptors_raw": [],
    "levels_raw": "alchemist 3, bloodrager 3, cleric/oracle 3, druid 3, inquisitor 3, occultist 3, psychic 3, ranger 2, shaman 3, sorcerer/wizard 3, spiritualist 3, summoner/unchained summoner 3",
    "domains_raw": "luck 3, protection 3; Bloodline destined 3, elemental 3 Elemental School air 3, earth 3, fire 3, water 3; Mystery volcano 3",
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, DF",
    "range_raw": "touch",
