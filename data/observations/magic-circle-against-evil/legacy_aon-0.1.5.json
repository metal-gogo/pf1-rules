    ],
    "levels_raw": "cleric 3, paladin 3, sorcerer/wizard 3",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M/DF (a 3-ft.-diameter circle of powdered silver)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Area",
        "value_raw": "10-ft.-radius emanation from touched creature",
        "kinds": [
