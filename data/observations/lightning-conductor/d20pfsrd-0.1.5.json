    ],
    "levels_raw": "bloodrager 2, druid 3, magus 3, sorcerer/wizard 3",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M/DF (a miniature metal rod)",
    "range_raw": "personal",
    "delivery_fields_raw": [
      {
