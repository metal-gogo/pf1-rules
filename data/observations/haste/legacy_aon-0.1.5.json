  "spell_raw": {
    "name_raw": "Haste",
    "alternate_names_raw": [],
    "school_raw": "transmutation",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "bard 3, sorcerer/wizard 3",
