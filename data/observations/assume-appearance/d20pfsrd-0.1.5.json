  "spell_raw": {
    "name_raw": "Assume Appearance",
    "alternate_names_raw": [],
    "school_raw": "transmutation (polymorph)",
    "subschool_raw": "polymorph",
    "descriptors_raw": [],
    "levels_raw": "alchemist 3, bard 3, medium 3, mesmerist 3, occultist 3, psychic 3, shaman 3, sorcerer/wizard 3, spiritualist 3, summoner 3, witch 3",
    "domains_raw": null,
    "casting_time_raw": "1 minute",
    "components_raw": "V, S, F (corpse of the deceased creature whose form you plan to assume)",
    "range_raw": "personal",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
