    "levels_raw": "antipaladin 4, bloodrager 4, cleric 4, psychic 4, sorcerer/wizard 4, spiritualist 4",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a polished humanoid femur)",
    "range_raw": "close (25 ft. + 5 ft./2 level)",
    "delivery_fields_raw": [
      {
        "label_raw": "Effect",
        "value_raw": "solid wall of humanoid bones with an area of up to one 5-ft. square/level",
