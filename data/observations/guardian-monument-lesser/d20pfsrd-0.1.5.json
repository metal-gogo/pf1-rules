    "levels_raw": "bard 3, inquisitor 3, magus 3, occultist 3, paladin 3, psychic 3, shaman 4, sorcerer/wizard 3, witch 3",
    "domains_raw": null,
    "casting_time_raw": "1 full round",
    "components_raw": "V, S, F (an unattended, non-magical object)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Area",
        "value_raw": "40-ft. radius from touched object or 60-ft. radius from touched object; see text",
        "kinds": [
          "area"
        ]
      }
    ],
    "duration_raw": "1 hour/level",
    "saving_throw_raw": "Will negates (harmless)",
    "spell_resistance_raw": "yes",
    "description_raw": "You touch an unattended, non-magical object to create a touchstone for humans defending the area. Such human defenders are protected by a shimmering aura as long as they are in the area.\n\nThe spell grants each subject damage reduction 2/magic. Humans who leave the area and reenter regain the damage reduction.\n\nThe spell is suppressed if the object is moved from its place, but resumes if the object is put back. Its duration continues to elapse while it is suppressed this way.\n\nNormally, the area of effect is 40 feet from the touched object.\n\nIf the touched object is a monument to human achievement, the area increases to a 60-foot radius.\n\nGuardian Monument, Greater\nSchool abjuration; Level bard 5, inquisitor 5, occultist 5, psychic 5, sorcerer/wizard 5, witch 5",
