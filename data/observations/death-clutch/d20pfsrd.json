  "spell_raw": {
    "name_raw": "Death Clutch",
    "alternate_names_raw": [],
    "school_raw": "necromancy",
    "subschool_raw": null,
    "descriptors_raw": ["death", "evil"],
    "levels_raw": "cleric 8, druid 9, psychic 8, sorcerer/wizard 8, witch 8",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S",
