  "spell_raw": {
    "name_raw": "Commune With Texts",
    "alternate_names_raw": [],
    "school_raw": "divination",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "bard 5, cleric 6, inquisitor 6, medium 4, occultist 4, psychic 6, sorcerer/wizard 5, spiritualist 6",
    "domains_raw": null,
    "casting_time_raw": "1 minute",
    "components_raw": "V, S, M (incense worth 250 gp)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "a collection of texts",
