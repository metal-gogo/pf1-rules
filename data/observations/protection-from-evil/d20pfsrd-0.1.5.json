      "good"
    ],
    "levels_raw": "cleric/oracle 1, inquisitor 1, paladin 1, shaman 1, sorcerer/wizard 1, summoner/unchained summoner 1",
    "domains_raw": "good 1",
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M/DF",
    "range_raw": "touch",
    "delivery_fields_raw": [
