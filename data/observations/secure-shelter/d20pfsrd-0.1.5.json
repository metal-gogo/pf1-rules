    "casting_time_raw": "10 minutes",
    "components_raw": "V, S, M (a chip of stone, sand, a drop of water, and a wood splinter)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
