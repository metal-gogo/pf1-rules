    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, F (human-shaped fetish made of bones)",
    "range_raw": "medium (100 ft. + 10 ft./level)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one living creature or undead creature with a skeleton",
