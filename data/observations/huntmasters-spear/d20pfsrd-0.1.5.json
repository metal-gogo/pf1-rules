  "spell_raw": {
    "name_raw": "Huntmaster’s Spear",
    "alternate_names_raw": [],
    "school_raw": "transmutation",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "antipaladin 1, bloodrager 2, druid 2, hunter 1, inquisitor 2, magus 2, occultist 2, paladin 1, ranger 1, shaman 2",
    "domains_raw": null,
    "casting_time_raw": "10 minutes",
    "components_raw": "V, S, M/DF (see text)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
