  "spell_raw": {
    "name_raw": "Invoke Primal Power",
    "alternate_names_raw": [],
    "school_raw": "transmutation",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "druid 5",
    "domains_raw": null,
    "casting_time_raw": "1 swift action",
