  "spell_raw": {
    "name_raw": "Psychic Reading",
    "alternate_names_raw": [],
    "school_raw": "divination",
    "subschool_raw": null,
    "descriptors_raw": [],
    "levels_raw": "bard 2, inquisitor 2, medium 1, mesmerist 1, occultist 1, psychic 1, sorcerer/wizard 2, spiritualist 1",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "one humanoid creature",
