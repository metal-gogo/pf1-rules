    "levels_raw": "bard 3, psychic 3, sorcerer/wizard 3",
    "domains_raw": null,
    "casting_time_raw": "1 minute",
    "components_raw": "V, S",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
