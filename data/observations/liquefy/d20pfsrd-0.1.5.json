    "levels_raw": "alchemist 3, bard 3, druid 4, sorcerer/wizard 4",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (a specially prepared glass bottle)",
    "range_raw": "close (25 ft. + 5 ft./2 levels)",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "1 object weighing up to 1 pound/level",
