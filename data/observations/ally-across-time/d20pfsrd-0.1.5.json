    "levels_raw": "arcanist 2, bard 2, cleric/oracle 2, hunter 1, inquisitor 2, medium 1, psychic 2, ranger 1, skald 2, sorcerer/wizard 2, warpriest 2",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
