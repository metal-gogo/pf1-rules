    "descriptors_raw": [],
    "levels_raw": "alchemist 2, bard 2, cleric 2, inquisitor 2, medium 2, mesmerist 2, occultist 2, paladin 2, psychic 2, sorcerer/wizard 2, spiritualist 2, witch 2",
