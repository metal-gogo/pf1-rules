    "levels_raw": "cleric 4, inquisitor 4, paladin 4",
    "domains_raw": null,
    "casting_time_raw": "1 standard action",
    "components_raw": "V, S, M (dried blood from an evil outsider, sprinkled on the weapon)",
    "range_raw": "touch",
    "delivery_fields_raw": [
      {
        "label_raw": "Target",
        "value_raw": "melee weapon touched",
