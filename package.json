{
  "name": "pf1-rules",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, provenance-aware Pathfinder First Edition rules database",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "web": "tsx src/web/server.ts",
    "web:dev": "tsx watch src/web/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "tsx src/cli.ts validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:import": "tsx src/cli.ts import",
    "db:setup": "prisma generate && prisma migrate deploy && tsx src/cli.ts import",
    "db:rebuild": "prisma migrate reset --force && tsx src/cli.ts import",
    "db:check": "tsx src/cli.ts check",
    "db:stats": "tsx src/cli.ts stats",
    "db:studio": "prisma studio",
    "catalog:level-0": "tsx src/ingestion/level-zero-catalog.ts 0",
    "catalog:level-1": "tsx src/ingestion/level-zero-catalog.ts 1",
    "catalog:level-2": "tsx src/ingestion/level-zero-catalog.ts 2",
    "catalog:level-3": "tsx src/ingestion/level-zero-catalog.ts 3",
    "catalog:level-4": "tsx src/ingestion/level-zero-catalog.ts 4",
    "catalog:level-5": "tsx src/ingestion/level-zero-catalog.ts 5",
    "catalog:level-6": "tsx src/ingestion/level-zero-catalog.ts 6",
    "catalog:level-7": "tsx src/ingestion/level-zero-catalog.ts 7",
    "catalog:level-8": "tsx src/ingestion/level-zero-catalog.ts 8",
    "catalog:level-9": "tsx src/ingestion/level-zero-catalog.ts 9",
    "ingest:level-0": "tsx src/ingestion/ingest-level-zero-batch.ts 1 0",
    "ingest:level-0:all": "tsx src/ingestion/ingest-level-zero-batch.ts all 0",
    "ingest:level-1": "tsx src/ingestion/ingest-level-zero-batch.ts 1 1",
    "ingest:level-1:all": "tsx src/ingestion/ingest-level-zero-batch.ts all 1",
    "ingest:level-2": "tsx src/ingestion/ingest-level-zero-batch.ts 1 2",
    "ingest:level-2:all": "tsx src/ingestion/ingest-level-zero-batch.ts all 2",
    "ingest:level-3": "tsx src/ingestion/ingest-level-zero-batch.ts 1 3",
    "ingest:level-3:all": "tsx src/ingestion/ingest-level-zero-batch.ts all 3",
    "ingest:level-4": "tsx src/ingestion/ingest-level-zero-batch.ts 1 4",
    "ingest:level-4:all": "tsx src/ingestion/ingest-level-zero-batch.ts all 4",
    "ingest:level-5": "tsx src/ingestion/ingest-level-zero-batch.ts 1 5",
    "ingest:level-5:all": "tsx src/ingestion/ingest-level-zero-batch.ts all 5",
    "ingest:level-6": "tsx src/ingestion/ingest-level-zero-batch.ts 1 6",
    "ingest:level-6:all": "tsx src/ingestion/ingest-level-zero-batch.ts all 6",
    "ingest:level-7": "tsx src/ingestion/ingest-level-zero-batch.ts 1 7",
    "ingest:level-7:all": "tsx src/ingestion/ingest-level-zero-batch.ts all 7",
    "ingest:level-8": "tsx src/ingestion/ingest-level-zero-batch.ts 1 8",
    "ingest:level-8:all": "tsx src/ingestion/ingest-level-zero-batch.ts all 8",
    "ingest:level-9": "tsx src/ingestion/ingest-level-zero-batch.ts 1 9",
    "ingest:level-9:all": "tsx src/ingestion/ingest-level-zero-batch.ts all 9",
    "ingest:dependencies": "tsx src/ingestion/ingest-level-zero-batch.ts dependencies",
    "ingest:retry-d20": "tsx src/ingestion/ingest-level-zero-batch.ts retry-d20 all",
    "ingest:retry-normalization": "tsx src/ingestion/ingest-level-zero-batch.ts retry-normalization all",
    "ingest:retry-source-issues": "tsx src/ingestion/ingest-level-zero-batch.ts retry-source-issues all",
    "ingest:retry-reviewed-overrides": "tsx src/ingestion/ingest-level-zero-batch.ts retry-reviewed-overrides",
    "ingest:legacy-3.5": "tsx src/ingestion/ingest-level-zero-batch.ts legacy-3.5",
    "ingest:all-spells-completeness": "tsx src/ingestion/ingest-level-zero-batch.ts all-spells-completeness",
    "ingest:reconcile-red-mantis": "tsx src/ingestion/ingest-level-zero-batch.ts reconcile-red-mantis",
    "ingest:reconcile-sahir-afiyun": "tsx src/ingestion/ingest-level-zero-batch.ts reconcile-sahir-afiyun",
    "ingest:reconcile-inherited-lists": "tsx src/ingestion/reconcile-inherited-class-lists.ts",
    "ingest:owner-mysteries": "tsx src/ingestion/ingest-owner-spell-lists.ts mysteries",
    "ingest:owner-patrons": "tsx src/ingestion/ingest-owner-spell-lists.ts patrons",
    "ingest:owner-spirits": "tsx src/ingestion/ingest-owner-spell-lists.ts spirits",
    "ingest:owner-sorcerer-bloodlines": "tsx src/ingestion/ingest-owner-spell-lists.ts sorcerer-bloodlines",
    "ingest:owner-bloodrager-bloodlines": "tsx src/ingestion/ingest-owner-spell-lists.ts bloodrager-bloodlines",
    "ingest:owner-domains": "tsx src/ingestion/ingest-owner-spell-lists.ts domains",
    "ingest:rollout-inheritance": "tsx src/ingestion/ingest-level-zero-batch.ts rollout-inheritance",
    "ingest:linked-entities": "tsx src/ingestion/ingest-linked-entities.ts",
    "evaluate:markdown-new": "tsx src/experiments/markdown-new-evaluation.ts",
    "audit:foundry-memberships": "tsx src/audits/audit-foundry-memberships.ts",
    "verify": "pnpm validate && pnpm typecheck && pnpm db:check && pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/adapter-neon": "7.9.1",
    "@prisma/client": "7.9.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cheerio": "^1.2.0",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@11.22.0"
}
