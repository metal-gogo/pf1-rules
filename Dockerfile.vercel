FROM node:24.19.0-bookworm AS build

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN PF1_VERIFY_ARTIFACTS=0 pnpm db:setup && pnpm build && pnpm prune --prod

FROM node:24.19.0-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
ENV PF1_DATABASE_PATH=/app/data/database/pf1_spells.db

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/data/database/pf1_spells.db ./data/database/pf1_spells.db

CMD ["sh", "-c", "PF1_WEB_HOST=0.0.0.0 PF1_WEB_PORT=${PORT:-3000} node dist/src/web/server.js"]
