{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pf1-rules.local/schemas/spell-ingestion-manifest.schema.json",
  "title": "Spell ingestion manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "manifest_id", "generated_at", "level", "batch_size", "source", "parser", "catalog_pages", "discovered_dependencies", "spells"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "0.1.0" },
    "manifest_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "level": { "type": "integer", "minimum": 0, "maximum": 9 },
    "batch_size": { "type": "integer", "minimum": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "catalog_root_url", "license_url", "first_party_status"],
      "properties": {
        "site_id": { "const": "aon" },
        "catalog_root_url": { "type": "string", "format": "uri" },
        "license_url": { "type": "string", "format": "uri" },
        "first_party_status": { "const": "confirmed" }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "catalog_pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/catalogPage" }
    },
    "discovered_dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/discoveredDependency" }
    },
    "spells": {
      "type": "array",
      "items": { "$ref": "#/$defs/spell" }
    }
  },
  "$defs": {
    "dependencyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_spell_id", "observation_id", "source_field", "anchor_text_raw", "source_href"],
      "properties": {
        "owner_spell_id": { "type": "string", "pattern": "^spell\\.[a-z0-9][a-z0-9-]*$" },
        "observation_id": { "type": "string", "minLength": 1 },
        "source_field": { "type": "string", "minLength": 1 },
        "anchor_text_raw": { "type": ["string", "null"] },
        "source_href": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "discoveredDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spell_id", "name", "source_url", "reason", "status", "discovered_from"],
      "properties": {
        "spell_id": { "type": "string", "pattern": "^spell\\.[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "reason": { "enum": ["rules_inheritance", "linked_spell"] },
        "status": { "enum": ["pending", "ingested", "issue"] },
        "discovered_from": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dependencyEvidence" }
        },
        "issue": { "$ref": "#/$defs/issue" }
      }
    },
    "catalogPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spell_list_id", "list_name", "source_url", "retrieved_at", "http_status", "content_sha256", "raw_artifact_path", "response_content_type", "level_entry_count"],
      "properties": {
        "spell_list_id": { "type": "string", "pattern": "^spell-list\\.[a-z0-9-]+$" },
        "list_name": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "raw_artifact_path": { "type": "string", "minLength": 1 },
        "response_content_type": { "type": "string", "minLength": 1 },
        "level_entry_count": { "type": "integer", "minimum": 0 }
      }
    },
    "catalogMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spell_list_id", "list_name", "level", "catalog_source_url", "summary_raw", "flags", "pfs_legal", "legacy_3_5_material"],
      "properties": {
        "spell_list_id": { "type": "string", "pattern": "^spell-list\\.[a-z0-9-]+$" },
        "list_name": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "minimum": 0, "maximum": 9 },
        "catalog_source_url": { "type": "string", "format": "uri" },
        "summary_raw": { "type": "string" },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["F", "M", "R", "T", "Y"] }
        },
        "pfs_legal": { "type": "boolean" },
        "legacy_3_5_material": { "type": "boolean" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message"],
      "properties": {
        "kind": { "enum": ["schema", "source", "scope"] },
        "code": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "spell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spell_id", "name", "source_url", "batch", "priority", "catalog_memberships"],
      "properties": {
        "spell_id": { "type": "string", "pattern": "^spell\\.[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "batch": { "type": "integer", "minimum": 1 },
        "priority": { "type": "integer", "minimum": 1 },
        "catalog_memberships": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/catalogMembership" }
        },
        "issue": { "$ref": "#/$defs/issue" }
      }
    }
  }
}
