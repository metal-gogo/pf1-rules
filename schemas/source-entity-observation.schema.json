{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/pf1/schemas/source-entity-observation.schema.json",
  "title": "PF1 Source Entity Observation",
  "description": "An immutable observation of a non-spell rules entity from a source page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "entity_type", "source", "retrieval", "parser", "page", "entity_raw", "warnings"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "0.1.0" },
    "observation_id": { "type": "string", "pattern": "^(aon|legacy_aon|d20pfsrd):[a-z][a-z0-9_-]*\\.[a-z0-9][a-z0-9.-]*:[a-f0-9]{8,64}$" },
    "entity_type": { "enum": ["rule", "condition", "feat", "class_feature", "deity", "domain", "subdomain", "mystery", "bloodline", "patron", "spirit", "archetype", "monster", "item", "magic_school", "subschool", "descriptor", "spell_list", "action", "publication", "visual_aid", "unknown"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "url"],
      "properties": {
        "site_id": { "enum": ["aon", "legacy_aon", "d20pfsrd"] },
        "url": { "type": "string", "format": "uri" },
        "license_url": { "type": ["string", "null"], "format": "uri" },
        "declared_publisher": { "type": ["string", "null"] },
        "first_party_status": { "enum": ["confirmed", "suspected", "third_party", "unknown"] }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieved_at", "http_status", "content_sha256", "raw_artifact_path"],
      "properties": {
        "retrieved_at": { "type": "string", "format": "date-time" },
        "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "raw_artifact_path": { "type": "string", "minLength": 1 },
        "response_content_type": { "type": ["string", "null"] }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "parsed_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "parsed_at": { "type": "string", "format": "date-time" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title_raw"],
      "properties": {
        "title_raw": { "type": ["string", "null"] },
        "breadcrumbs_raw": { "type": "array", "items": { "type": "string" } },
        "license_notice_raw": { "type": ["string", "null"] },
        "source_notice_raw": { "type": ["string", "null"] }
      }
    },
    "entity_raw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_raw", "definition_type_raw", "source_book_raw", "definition_raw", "links_raw", "sections_raw"],
      "properties": {
        "name_raw": { "type": "string", "minLength": 1 },
        "definition_type_raw": { "type": ["string", "null"] },
        "source_book_raw": { "type": ["string", "null"] },
        "definition_raw": { "type": "string", "minLength": 1 },
        "links_raw": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["anchor_text_raw", "href_raw", "href_resolved", "source_field", "context_raw", "role_hint", "target_entity_type_hint", "target_entity_id_hint"],
            "properties": {
              "anchor_text_raw": { "type": "string", "minLength": 1 },
              "href_raw": { "type": "string", "minLength": 1 },
              "href_resolved": { "type": "string", "format": "uri" },
              "source_field": { "type": "string", "minLength": 1 },
              "context_raw": { "type": "string", "minLength": 1 },
              "role_hint": { "enum": ["classification", "spell_list", "definition", "publication", "cross_reference", "unknown"] },
              "target_entity_type_hint": { "enum": ["rule", "condition", "deity", "mystery", "archetype", "magic_school", "subschool", "descriptor", "spell_list", "action", "publication", "unknown"] },
              "target_entity_id_hint": { "type": ["string", "null"] }
            }
          }
        },
        "sections_raw": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["heading_raw", "body_raw"],
            "properties": {
              "heading_raw": { "type": ["string", "null"] },
              "body_raw": { "type": "string", "minLength": 1 }
            }
          }
        },
        "document_raw": {
          "description": "Structured source prose. Rules-page adapters use the same node contract as canonical spell rich text.",
          "type": "object",
          "additionalProperties": false,
          "required": ["node_type", "content"],
          "properties": {
            "node_type": { "const": "document" },
            "content": { "type": "array" }
          }
        },
        "navigation_headings_raw": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "severity": { "enum": ["info", "warning", "error"] },
          "field": { "type": ["string", "null"] },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
