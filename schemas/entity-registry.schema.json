{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/pf1/schemas/entity-registry.schema.json",
  "title": "PF1 Canonical Entity Registry",
  "description": "A registry of resolved entities and name/ID placeholders discovered while importing links and structured fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "entities"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "0.1.0"},
    "registry_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "entities": {
      "type": "array",
      "items": {"$ref": "#/$defs/entity"}
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "entity_type", "name", "status", "aliases", "evidence", "notes"],
      "properties": {
        "entity_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)*$"},
        "entity_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "class_type": {"enum": ["npc"]},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["stub", "resolved"]},
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observation_id", "source_field", "anchor_text_raw", "source_href"],
            "properties": {
              "observation_id": {"type": "string"},
              "source_field": {"type": "string"},
              "anchor_text_raw": {"type": ["string", "null"]},
              "source_href": {"type": ["string", "null"]}
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "relationships": {
          "type": "array",
          "description": "Canonical semantic edges owned by this registry entity.",
          "items": {"$ref": "#/$defs/relationship"}
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "type", "target", "status", "evidence", "note"],
      "properties": {
        "relationship_id": {"type": "string", "pattern": "^[a-z0-9.-]+:[a-z_]+:[a-z0-9.-]+$"},
        "type": {"enum": ["owns_spell_list", "grants_spell_access", "inherits_spell_list", "references", "unknown"]},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity_type", "entity_id", "name"],
          "properties": {
            "entity_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "entity_id": {"type": ["string", "null"]},
            "name": {"type": "string", "minLength": 1}
          }
        },
        "status": {"enum": ["accepted", "pending_review", "rejected"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observation_id", "source_field", "evidence_kind", "anchor_text_raw", "source_href"],
            "properties": {
              "observation_id": {"type": "string"},
              "source_field": {"type": "string"},
              "evidence_kind": {"enum": ["hyperlink", "plain_text", "manual_verification"]},
              "anchor_text_raw": {"type": ["string", "null"]},
              "source_href": {"type": ["string", "null"]}
            }
          }
        },
        "note": {"type": ["string", "null"]},
        "parameters": {"type": "object"}
      }
    }
  }
}
